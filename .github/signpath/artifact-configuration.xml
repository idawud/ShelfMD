<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for ShelfMD release installers.
  Paste into SignPath: Project "ShelfMD" > Artifact Configurations.
  The GitHub artifact is a zip with the NSIS .exe and the .msi at its root.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" max-matches="unbounded">
      <authenticode-sign />
    </pe-file>
    <msi-file path="*.msi" max-matches="unbounded">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
